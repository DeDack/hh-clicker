# Copy this file to .env and replace placeholder values.
# Do not commit .env. Secrets below are examples only.

# PostgreSQL. Required.
POSTGRES_DB=hh_clicker
POSTGRES_USER=hh_clicker
POSTGRES_PASSWORD=change-me-postgres-password

# JWT. Required. Use long random strings, at least 32 characters.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
JWT_REFRESH_COOKIE_NAME=refreshToken

# HTTP/IP first launch. For HTTPS set APP_COOKIE_SECURE=true.
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax

# HH session encryption. Required. Use 16, 24, or 32 byte text, or base64 key.
HH_SESSION_ENCRYPTION_KEY=change-me-32-byte-hh-session-key!!

# Java -> Python internal adapter. Required and must match in both services.
HH_ADAPTER_API_KEY=change-me-internal-adapter-key
HH_ADAPTER_CONNECT_TIMEOUT_SECONDS=5
HH_ADAPTER_READ_TIMEOUT_SECONDS=90

# Optional first admin seed.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# CORS is mostly unused in production because frontend and API share origin.
FRONTEND_ORIGIN=http://localhost

# LLM provider. Empty KOMAPI_API_KEY keeps the site working, but AI status is not configured.
LLM_PROVIDER=komapi
KOMAPI_API_KEY=
KOMAPI_BASE_URL=https://www.komapi.top
KOMAPI_MODEL=claude-haiku-4-5
KOMAPI_ANTHROPIC_VERSION=2023-06-01
KOMAPI_MAX_TOKENS=700
KOMAPI_TIMEOUT_SECONDS=60

# Cover letter generation limits.
COVER_LETTER_MAX_TOKENS=220
COVER_LETTER_RESUME_PROMPT_CHARS=1600
COVER_LETTER_VACANCY_PROMPT_CHARS=1600
COVER_LETTER_MAX_CONCURRENCY=3
COVER_LETTER_MAX_RETRIES=3
COVER_LETTER_RETRY_BASE_DELAY_SECONDS=1
